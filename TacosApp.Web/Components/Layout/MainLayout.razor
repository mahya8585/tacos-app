@inherits LayoutComponentBase
@inject TacosApp.Web.Services.CartService CartSvc

@{
    var cartCount = CartSvc.GetCart().ItemCount;
}

<nav class="navbar navbar-expand-lg navbar-dark bg-taco">
    <div class="container">
        <a class="navbar-brand" href="/">🌮 タコスデリバリー</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">メニュー</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/cart">
                        🛒 カート <span class="badge bg-light text-dark" id="navCartCount">@cartCount</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container mt-4 mb-5">
    @Body
</main>

<footer class="bg-light mt-5 py-3">
    <div class="container text-center text-muted">
        <small>&copy; 2024 タコスデリバリー — お届け時間の目安：30～60分</small>
    </div>
</footer>
