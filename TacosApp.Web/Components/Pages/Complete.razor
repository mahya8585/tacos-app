@page "/complete/{OrderNumber}"

<PageTitle>注文完了 — 🌮 タコスデリバリー</PageTitle>

<div class="text-center py-5">
    <div class="mb-3" style="font-size:4rem">🎉</div>
    <h2 class="mb-2">ご注文ありがとうございます！</h2>
    <p class="text-muted fs-5 mb-4">注文番号: <strong>@OrderNumber</strong></p>
    <p class="mb-4">30〜60分以内にお届けします。<br/>状況はリアルタイムで確認できます。</p>
    <a href="/status/@OrderNumber" class="btn btn-taco btn-lg me-2">注文状況を確認する</a>
    <a href="/" class="btn btn-outline-secondary btn-lg">メニューへ戻る</a>
</div>

@code {
    [Parameter] public string OrderNumber { get; set; } = "";
}
