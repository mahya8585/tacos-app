<%@ Master Language="C#" Inherits="System.Web.Mvc.ViewMasterPage" %>
<%@ Import Namespace="System" %>
<!DOCTYPE html>
<html lang="ja">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Convert.ToString(ViewData["Title"]) %> - 🌮 タコスデリバリー</title>
    <%: System.Web.Optimization.Styles.Render("~/Content/css") %>
    <style>
        .master-content { min-height: calc(100vh - 160px); }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-taco">
        <div class="container">
            <a class="navbar-brand" href="<%: Url.Action("Index", "Home") %>">🌮 タコスデリバリー</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="<%: Url.Action("Index", "Home") %>">メニュー</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%: Url.Action("Cart", "Order") %>">
                            🛒 カート <span class="badge badge-light cart-count" id="navCartCount">0</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4 mb-5 master-content">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="footer bg-light mt-5 py-3">
        <div class="container text-center text-muted">
            <small>&copy; 2024 タコスデリバリー — お届け時間の目安：30〜60分</small>
        </div>
    </footer>

    <%: System.Web.Optimization.Scripts.Render("~/bundles/jquery") %>
    <%: System.Web.Optimization.Scripts.Render("~/bundles/bootstrap") %>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>