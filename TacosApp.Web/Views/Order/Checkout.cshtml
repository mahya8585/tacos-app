@model TacosApp.Web.Models.ViewModels.CheckoutViewModel
@{
    ViewBag.Title = "お届け先の入力";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h2 class="taco-heading mb-4">📍 お届け先の入力</h2>

        @using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "needs-validation" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                @Html.LabelFor(m => m.CustomerName)
                @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "山田 太郎" })
                @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Phone)
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "090-1234-5678", type = "tel" })
                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.DeliveryAddress)
                @Html.TextAreaFor(m => m.DeliveryAddress, 3, 0,
                    new { @class = "form-control", placeholder = "東京都渋谷区○○町1-2-3 ×× マンション 101号室" })
                @Html.ValidationMessageFor(m => m.DeliveryAddress, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.DeliveryNote)
                @Html.TextAreaFor(m => m.DeliveryNote, 2, 0,
                    new { @class = "form-control", placeholder = "例：インターホンが壊れているため電話でご連絡ください" })
                @Html.ValidationMessageFor(m => m.DeliveryNote, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-taco btn-block">内容を確認する →</button>
                <a href="@Url.Action("Cart", "Order")" class="btn btn-outline-secondary btn-block mt-2">カートへ戻る</a>
            </div>
        }
    </div>
</div>
