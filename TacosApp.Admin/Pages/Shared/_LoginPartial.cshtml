@using Microsoft.AspNetCore.Identity
@using TacosApp.Admin.Models
@inject SignInManager<AdminUser> SignInManager
@inject UserManager<AdminUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrEmpty(userName) ? "?" : userName.Substring(0, 1).ToUpperInvariant();

    <div class="dropdown">
        <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="user-avatar">@initial</span>
            <span class="user-name d-none d-sm-inline">@userName</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
            <li class="dropdown-header"><i class="bi bi-person-circle me-1"></i>@userName</li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-gear me-2"></i>アカウント設定
                </a>
            </li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>ログアウト
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>ログイン
        </a>
    </div>
}
