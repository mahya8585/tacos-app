@page
@model IndexModel
@{
    ViewData["Title"] = "ダッシュボード";
}

<div class="page-header">
    <div>
        <h1 class="page-title">ダッシュボード</h1>
        <p class="page-subtitle">注文状況と売上の概況をリアルタイムに把握できます</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-page="/Orders/Index">
            <i class="bi bi-receipt me-1"></i>注文一覧へ
        </a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card stat-primary">
        <div class="stat-icon"><i class="bi bi-receipt"></i></div>
        <div class="stat-label">合計注文</div>
        <div class="stat-value">@Model.Stats.Total</div>
        <div class="stat-meta">累計 (全ステータス)</div>
    </div>
    <div class="stat-card stat-warning">
        <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
        <div class="stat-label">受付中</div>
        <div class="stat-value">@Model.Stats.Received</div>
        <div class="stat-meta">未処理の新規注文</div>
    </div>
    <div class="stat-card stat-info">
        <div class="stat-icon"><i class="bi bi-fire"></i></div>
        <div class="stat-label">調理中</div>
        <div class="stat-value">@Model.Stats.Preparing</div>
        <div class="stat-meta">キッチンで進行中</div>
    </div>
    <div class="stat-card stat-success">
        <div class="stat-icon"><i class="bi bi-currency-yen"></i></div>
        <div class="stat-label">配達完了 売上</div>
        <div class="stat-value">¥@Model.Stats.TotalRevenue.ToString("N0")</div>
        <div class="stat-meta">完了注文の合計金額</div>
    </div>
</div>

<div class="page-header">
    <div>
        <h2 class="page-title" style="font-size:18px;">最近の注文</h2>
        <p class="page-subtitle">直近の注文を素早く確認</p>
    </div>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>注文番号</th>
                    <th>顧客</th>
                    <th>合計</th>
                    <th>ステータス</th>
                    <th>注文日時</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td><code>@order.OrderNumber</code></td>
                        <td>@order.CustomerName</td>
                        <td>¥@order.TotalAmount.ToString("N0")</td>
                        <td><span class="badge bg-secondary">@order.Status</span></td>
                        <td>@order.OrderedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Orders/Details" asp-route-id="@order.OrderId">
                                <i class="bi bi-eye me-1"></i>詳細
                            </a>
                        </td>
                    </tr>
                }
                @if (Model.RecentOrders.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">注文はまだありません</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
