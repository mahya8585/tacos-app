@page
@model TacosApp.Admin.Pages.Toppings.IndexModel
@{
    ViewData["Title"] = "トッピング管理";
}

<div class="page-header">
    <div>
        <h1 class="page-title">トッピング管理</h1>
        <p class="page-subtitle">追加できるトッピングと価格を管理します</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg me-1"></i>新規トッピング</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>表示順</th>
                    <th>トッピング名</th>
                    <th class="text-end">価格</th>
                    <th>提供中</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Toppings)
                {
                    <tr>
                        <td>@t.DisplayOrder</td>
                        <td><strong>@t.Name</strong></td>
                        <td class="text-end">¥@t.Price.ToString("N0")</td>
                        <td>
                            @if (t.IsAvailable)
                            {
                                <span class="badge bg-success">提供中</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">休止中</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@t.ToppingId"><i class="bi bi-pencil me-1"></i>編集</a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@t.ToppingId"><i class="bi bi-trash me-1"></i>削除</a>
                        </td>
                    </tr>
                }
                @if (Model.Toppings.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">トッピングはまだ登録されていません</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
